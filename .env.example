# mope.io local stack: environment variables
# Paste into Koyeb / Railway / Render ("bulk import" or "add from .env"), or save as .env for local runs.

# Port the server listens on (Koyeb/Railway set or expect this; keep it equal to the exposed port)
PORT=8080

# 1 = shop purchases are free, 0 = purchases cost coins/gems
MOPE_FREE_SHOP=1

# Accounts with unlimited coins/gems and every skin unlocked (comma-separated).
# These two are already built in; listing them here is harmless.
MOPE_INFINITE_EMAILS=moonlightw12575@gmail.com,emerybhased@gmail.com

# Upgrade menu: all = every animal (split by tier), tier = only the next tier of your biome
MOPE_UPGRADE_MODE=all

# Google login (optional). Uncomment and set your OAuth Web client id, then add your site's
# https address under "Authorized JavaScript origins" in Google Cloud Console.
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Keep accounts across redeploys on hosts WITHOUT a disk (free tiers): a Postgres connection string
# (Neon, Supabase, Railway, Render all have free tiers). The server restores accounts from it at
# startup and saves a snapshot whenever they change.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Supabase: use the *Session pooler* string (Connect > Session pooler), host ...pooler.supabase.com, port 5432.
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).

# Only on hosts with a persistent disk/volume: where the accounts database lives.
# Leave unset on free hosts without a volume (accounts then reset on redeploy).
# DB_DIR=/data
